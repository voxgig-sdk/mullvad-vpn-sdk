# Entity: ip_information

main: kit: entity: ip_information: {

  alias: field: {}

  fields: [
    {
      name: "blacklisted"
      req: false
      type: "`$BOOLEAN`"
    }
    {
      name: "results"
      req: false
      type: "`$ARRAY`"
    }
  ]

  name: "ip_information"
  op: {
    load: {
      name: "load"
      points: [
        {
          method: "GET"
          orig: "/json"
          parts: [
            "json"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.blacklisted`"
          }
        }
      ]
    }
  }



}
